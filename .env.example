# API 키 발급 절차는 docs/keys.html 참고 (초보자용 단계별 가이드).

# 네이버 즐겨찾기 수집용 세션 쿠키.
# 로그인된 브라우저의 DevTools > Application > Cookies 에서 NID_AUT 와 NID_SES 를 복사해
# "NID_AUT=...; NID_SES=..." 형태로 넣는다.
#
# 이 값은 계정 전체 권한을 가진다. 커밋하지 말 것 (.env 는 .gitignore 에 있다).
# CI 에서는 레포 Secret 인 NAVER_COOKIE 로 주입한다.
NAVER_COOKIE=

# 카카오 REST API 키 (필수, 무료). scripts/match.mjs 가 가게마다 카카오 장소 ID를
# 찾을 때 쓴다. developers.kakao.com > 내 애플리케이션 > 앱 키 > REST API 키.
# 지도에 쓰는 JS 앱키와는 다른 값이니 주의. GitHub Secrets 에도 같은 이름으로 등록한다.
KAKAO_REST_KEY=

# 구글 Places API 키 (선택, 결제 계정 필요). 구글 평점을 켤 때만 필요하다.
# 비워두면 구글 평점 칸은 "—" 로 남고 나머지는 그대로 동작한다.
# console.cloud.google.com 에서 발급, 키 제한은 "Places API (New)" 만 허용.
GOOGLE_PLACES_KEY=
